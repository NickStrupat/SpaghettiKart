# Writes NetplayBuildId.h, naming the commit plus a hash of any uncommitted changes, so that netplay only pairs
# players running the same code. Runs on every build; the header is rewritten only when the id changes.
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -P NetplayBuildId.cmake
execute_process(
  COMMAND git -c safe.directory=${SOURCE_DIR} rev-parse --short=12 HEAD
  WORKING_DIRECTORY ${SOURCE_DIR}
  OUTPUT_VARIABLE COMMIT
  RESULT_VARIABLE GIT_RESULT
  ERROR_QUIET
  OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT GIT_RESULT EQUAL 0 OR COMMIT STREQUAL "")
  set(BUILD_ID "unknown")
else()
  # Tracked changes to the code or build flags change what the simulation does.
  execute_process(
    COMMAND git -c safe.directory=${SOURCE_DIR} diff HEAD -- src include cmake CMakeLists.txt
    WORKING_DIRECTORY ${SOURCE_DIR}
    OUTPUT_VARIABLE DIFF
    ERROR_QUIET)
  if(DIFF STREQUAL "")
    set(BUILD_ID "${COMMIT}")
  else()
    string(SHA1 DIFF_HASH "${DIFF}")
    string(SUBSTRING "${DIFF_HASH}" 0 8 DIFF_HASH)
    set(BUILD_ID "${COMMIT}+${DIFF_HASH}")
  endif()
endif()

set(CONTENT "// Generated by cmake/NetplayBuildId.cmake\n#define NETPLAY_BUILD_ID \"${BUILD_ID}\"\n")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" OLD_CONTENT)
endif()
if(NOT "${OLD_CONTENT}" STREQUAL "${CONTENT}")
  file(WRITE "${OUTPUT}" "${CONTENT}")
endif()
