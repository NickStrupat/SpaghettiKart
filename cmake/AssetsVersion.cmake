# Writes AssetsVersionDefine.h: a hash of everything that shapes the mk64.o2r Torch makes from the ROM (Torch's commit and
# uncommitted changes, config.yml, yamls/, include/defines.h, meta/mods.toml). The extractor stamps it into the archive
# and the game compares it with its own (src/port/AssetsVersion.h), so that files made by an older version are noticed:
# netplay hides the rooms of players whose files differ. Runs on every build; the outputs are rewritten only when the
# version changes.
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> [-DTEXT_OUTPUT=<file>] -P AssetsVersion.cmake
# TEXT_OUTPUT gets the version alone, for the browser build's page (docs/WEB.md).
set(INPUTS "")
execute_process(
  COMMAND git -c safe.directory=${SOURCE_DIR}/torch rev-parse HEAD
  WORKING_DIRECTORY ${SOURCE_DIR}/torch
  OUTPUT_VARIABLE TORCH_COMMIT
  ERROR_QUIET
  OUTPUT_STRIP_TRAILING_WHITESPACE)
execute_process(
  COMMAND git -c safe.directory=${SOURCE_DIR}/torch diff HEAD
  WORKING_DIRECTORY ${SOURCE_DIR}/torch
  OUTPUT_VARIABLE TORCH_DIFF
  ERROR_QUIET)
string(SHA256 TORCH_DIFF_HASH "${TORCH_DIFF}")
string(APPEND INPUTS "torch ${TORCH_COMMIT} ${TORCH_DIFF_HASH}\n")

file(GLOB_RECURSE DESCRIPTIONS RELATIVE ${SOURCE_DIR} ${SOURCE_DIR}/yamls/*)
list(SORT DESCRIPTIONS)
foreach(FILE config.yml include/defines.h meta/mods.toml ${DESCRIPTIONS})
  file(SHA256 ${SOURCE_DIR}/${FILE} FILE_HASH)
  string(APPEND INPUTS "${FILE} ${FILE_HASH}\n")
endforeach()
string(SHA256 VERSION "${INPUTS}")
string(SUBSTRING "${VERSION}" 0 16 VERSION)

function(write_if_changed PATH CONTENT)
  if(EXISTS "${PATH}")
    file(READ "${PATH}" OLD_CONTENT)
  endif()
  if(NOT "${OLD_CONTENT}" STREQUAL "${CONTENT}")
    file(WRITE "${PATH}" "${CONTENT}")
  endif()
endfunction()

write_if_changed("${OUTPUT}" "// Generated by cmake/AssetsVersion.cmake\n#define SK_ASSETS_VERSION \"${VERSION}\"\n")
if(TEXT_OUTPUT)
  write_if_changed("${TEXT_OUTPUT}" "${VERSION}")
endif()
